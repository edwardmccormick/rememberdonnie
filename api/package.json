{
  "name": "rememberdonnie-api",
  "private": true,
  "type": "module",
  "description": "Memory wall and candle counter for rememberdonnie.com",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "build": "esbuild src/index.js --bundle --platform=node --target=node22 --format=cjs --minify --legal-comments=none --outfile=dist/index.js",
    "package": "npm run build && node ../scripts/zip-lambda.mjs dist/index.js dist/api.zip"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1150.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/client-secrets-manager": "3.1150.0",
    "@aws-sdk/client-sns": "3.1150.0",
    "@aws-sdk/lib-dynamodb": "3.1150.0",
    "@aws-sdk/s3-presigned-post": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0"
  },
  "devDependencies": {
    "esbuild": "0.28.0"
  }
}
